# ============================================================================
#  pay case study
#
#  Layout:  <stage>/<condition>/<protocol>.spthy
#  The condition tag keeps the same name at every stage, so one batch can never
#  end up being referred to by two different names.
#
#    condition = baseline | entropy
#
#    source/baseline/   original models
#    source/entropy/    models with low-entropy marks: ( ~password := `L` )
#    model/entropy/     generated by entropy_verif from source/entropy/
#    result/<cond>/     tamarin results
#    log/<cond>/        per-model tamarin logs
#
#  model/baseline/ does not exist on purpose: the baseline needs no generation
#  step, it goes straight from source/ to tamarin.
#
#  Targets:
#    make all        1. source/entropy/*.spthy --entropy_verif--> model/entropy/
#                    2. tamarin over model/entropy/   -> result/entropy/
#                    3. tamarin over source/baseline/ -> result/baseline/
#                    (both batches always run; exit status reported at the end)
#    make entropy    only the entropy batch (generation + verification)
#    make baseline   only re-run tamarin over source/baseline/
#
#  Override on the command line, e.g.:
#    make all JOBS=4 DERIVE_LEVEL=3 PROPAGATE_LEVEL=3
# ============================================================================

PY              := python3
ENTROPY_MAIN    := ../../entropy_verif/main.py
RUN_SCRIPT      := run.py

SRC_DIR         := source
MODELS_DIR      := model
RESULTS_DIR     := result
LOG_DIR         := log

SRC_BASELINE    := $(SRC_DIR)/baseline
SRC_ENTROPY     := $(SRC_DIR)/entropy
MODEL_ENTROPY   := $(MODELS_DIR)/entropy

# Tunables
JOBS            ?= 2
DERIVE_LEVEL    ?= 2
PROPAGATE_LEVEL ?= 1

ENTROPY_SRCS := $(wildcard $(SRC_ENTROPY)/*.spthy)
MODELS       := $(patsubst $(SRC_ENTROPY)/%.spthy,$(MODEL_ENTROPY)/%.spthy,$(ENTROPY_SRCS))

# One batch = one condition tag. -o and -log both derive from $(1), so the
# result and log directories cannot drift apart.
#   $(1) = condition tag   $(2) = directory holding the .spthy files to verify
RUN_BATCH = $(PY) $(RUN_SCRIPT) -d=$(2) -j=$(JOBS) \
            -o=$(RESULTS_DIR)/$(1) -log=$(LOG_DIR)/$(1)

RUN_ENTROPY  = $(call RUN_BATCH,entropy,$(MODEL_ENTROPY))
RUN_BASELINE = $(call RUN_BATCH,baseline,$(SRC_BASELINE))

.PHONY: all entropy baseline

# ---------------------------------------------------------------------------
# make all : generate, then verify BOTH conditions.
# run.py exits 1 when any file fails; without capturing the code here make
# would abort after the entropy batch and silently skip the baseline.
# ---------------------------------------------------------------------------
all: $(MODELS)
	@echo "[STEP] verify entropy"; \
	$(RUN_ENTROPY); rc_entropy=$$?; \
	echo ""; \
	echo "[STEP] verify baseline"; \
	$(RUN_BASELINE); rc_baseline=$$?; \
	echo ""; \
	echo "[SUMMARY] entropy rc=$$rc_entropy   baseline rc=$$rc_baseline"; \
	if [ $$rc_entropy -ne 0 ] || [ $$rc_baseline -ne 0 ]; then \
		echo "[FAIL] see $(LOG_DIR)/entropy/ and $(LOG_DIR)/baseline/"; \
		exit 1; \
	fi

# ---------------------------------------------------------------------------
# make entropy : the instrumented condition only (regenerates stale models)
# ---------------------------------------------------------------------------
entropy: $(MODELS)
	@echo "[STEP] verify entropy"
	$(RUN_ENTROPY)

# ---------------------------------------------------------------------------
# make baseline : the original models only (no generation needed)
# ---------------------------------------------------------------------------
baseline:
	@echo "[STEP] verify baseline"
	$(RUN_BASELINE)

# ---------------------------------------------------------------------------
# generation rule (incremental: only rebuilds models whose source changed)
# ---------------------------------------------------------------------------
$(MODEL_ENTROPY)/%.spthy: $(SRC_ENTROPY)/%.spthy | $(MODEL_ENTROPY)
	@echo "[GEN] $< -> $@ (derive=$(DERIVE_LEVEL), propagate=$(PROPAGATE_LEVEL))"
	@$(PY) $(ENTROPY_MAIN) $< -o $@ \
		--derive-level=$(DERIVE_LEVEL) --propagate-level=$(PROPAGATE_LEVEL)

$(MODEL_ENTROPY):
	@mkdir -p $@
