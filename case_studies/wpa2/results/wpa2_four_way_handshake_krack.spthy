rule (modulo E) Supp_Rekey_GroupKey[color=#3381ff]:
   [
   SuppState( ~suppThreadID, 'PTK_INIT_DONE',
              <~suppID, ~PMK, ~authThreadID, KDF(<PMK1, ANonce1, SNonce1>), 
               <GTK(y), <N(m), authID2>, $oldIndex>, ANonce, ~SNonce, 
               S(ctr_minus_1)>
   ),
   In_Supp( <
             <S(ctr_rekey_minus_1), 
              senc(<GTK(x), <N(n), authID1>, $newIndex>,
                   KDF(<PMK1, ANonce1, SNonce1>))
             >, 
             mic>,
            ~suppThreadID, KDF(<PMK1, ANonce1, SNonce1>)
   ),
   ReceiverGTK( ~suppThreadID, ~oldGTKID, ~PMK, GTK(y),
                <N(m), authID2>, $oldIndex
   ),
   Fr( ~newGTKID ), Fr( ~messageID )
   ]
  --[
  Eq( mic,
      MIC(KDF(<PMK1, ANonce1, SNonce1>),
          <S(ctr_rekey_minus_1), 
           senc(<GTK(x), <N(n), authID1>, $newIndex>,
                KDF(<PMK1, ANonce1, SNonce1>))
          >)
  ),
  SupplicantGroupKeyRekey( ~suppThreadID, ~suppID, ~PMK,
                           ~authThreadID, KDF(<PMK1, ANonce1, SNonce1>), GTK(y), GTK(x),
                           ANonce, ~SNonce, S(ctr_rekey_minus_1)
  ),
  SuppRcvM3AgainOrGroupRekey( ~suppThreadID, ~suppID, ~PMK,
                              ~authThreadID, KDF(<PMK1, ANonce1, SNonce1>), GTK(x), ANonce,
                              ~SNonce, S(ctr_rekey_minus_1)
  ),
  SupplicantSeesCounter( ~suppThreadID, ~PMK, S(ctr_rekey_minus_1) ),
  SupplicantInstalledGTK( ~newGTKID, ~suppThreadID, ~PMK, GTK(x),
                          <N(n), authID1>, $newIndex
  ),
  SeesNonceForGTK( ~newGTKID, ~suppThreadID, GTK(x), <N(n), authID1>
  ),
  EnqueueMessage( ~suppThreadID, ~messageID )
  ]->
   [
   SuppState( ~suppThreadID, 'PTK_INIT_DONE',
              <~suppID, ~PMK, ~authThreadID, KDF(<PMK1, ANonce1, SNonce1>), 
               <GTK(x), <N(n), authID1>, $newIndex>, ANonce, ~SNonce, 
               S(ctr_rekey_minus_1)>
   ),
   ReceiverGTK( ~suppThreadID, ~newGTKID, ~PMK, GTK(x),
                <N(n), authID1>, $newIndex
   ),
   Out_Supp_Rekey_GroupKey( <S(ctr_rekey_minus_1), 
                             MIC(KDF(<PMK1, ANonce1, SNonce1>), S(ctr_rekey_minus_1))>,
                            ~suppThreadID, ~messageID
   ),
   !MDerive0( combine(GTK(x), <N(n), authID1>),
              <GTK(x), <N(n), authID1>, $newIndex>
   ),
   !MDerive0( x, GTK(x) ),
   !MDerive0( combine(authID1, n), <N(n), authID1> ),
   !MDerive0( ctr_rekey_minus_1, S(ctr_rekey_minus_1) ),
   !MDerive0( x, GTK(x) ),
   !MDerive0( combine(authID1, n), <N(n), authID1> ),
   !MDerive0( ctr_rekey_minus_1, S(ctr_rekey_minus_1) ),
   !MDerive0( combine(KDF(<PMK1, ANonce1, SNonce1>),
                      S(ctr_rekey_minus_1)),
              MIC(KDF(<PMK1, ANonce1, SNonce1>), S(ctr_rekey_minus_1))
   ),
   !MDerive0( ctr_rekey_minus_1, S(ctr_rekey_minus_1) )
   ]

