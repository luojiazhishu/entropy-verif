rule (modulo E) Auth_Check_MIC_M2_Snd_M3[color=#ddb4ff]:
   [
   AuthState( ~authThreadID, 'PTK_CALC_NEGOTIATING',
              <~authID, ~PMK, ~suppThreadID, KDF(<PMK1, ANonce1, SNonce1>), 
               ~ANonce, SNonce, S(ctr_minus_1), <S(ctr_minus_1), SNonce>, mic_m2>
   ),
   !AuthGTKState( ~authID, stateIdentifier, installedGTKData,
                  <GTK(~x), <N(n), ~authID>, $index>, ~pointerGTKState
   ),
   Fr( ~messageID )
   ]
  --[
  Eq( mic_m2,
      MIC(KDF(<~PMK, ~ANonce, SNonce>), <S(ctr_minus_1), SNonce>)
  ),
