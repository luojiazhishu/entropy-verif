rule (modulo E) Auth_Rcv_M4_Install_Key[color=#ddb4ff]:
   [
   AuthState( ~authThreadID, 'PTK_CALC_NEGOTIATING3',
              <~authID, ~PMK, ~suppThreadID, KDF(<PMK1, ANonce1, SNonce1>), 
               ~ANonce, SNonce, S(ctr_minus_1)>
   ),
   !AuthReceiverPTK( ~oldReceiverPtkID, ~authThreadID, ~authID,
                     KDF(<PMK1, ANonce1, SNonce1>), ~oldPointerPTK
   ),
   In_Auth( <S(ctr_m4_minus_1), mic_m4>, ~authThreadID,
            KDF(<PMK1, ANonce1, SNonce1>)
   ),
   !UsedCounterInPTKHandshake( ~authThreadID, ~ANonce,
                               S(ctr_m4_minus_1)
   ),
   Fr( ~dataFramePtkID ), Fr( ~managementFramePtkID ),
   Fr( ~newReceiverPtkID ), Fr( ~gtkID ), Fr( ~counter ),
   Fr( ~newPointerPTK )
   ]
  --[
  AuthenticatorInstalled( ~authThreadID, ~authID, ~PMK,
                          ~suppThreadID, KDF(<~PMK, ~ANonce, SNonce>), ~ANonce, SNonce,
                          S(ctr_minus_1)
  ),
  AuthenticatorCommit( ~authThreadID, ~suppThreadID, ~PMK, ~ANonce,
                       SNonce, KDF(<~PMK, ~ANonce, SNonce>)
  ),
  AuthInstalledSenderPTK( ~dataFramePtkID, ~authThreadID, ~authID,
                          KDF(<~PMK, ~ANonce, SNonce>), <N('1'), ~authID, 'DF'>
  ),
  AuthInstalledSenderPTK( ~managementFramePtkID, ~authThreadID,
