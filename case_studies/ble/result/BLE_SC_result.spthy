              case InitDRequest
              solve( !KU( f6(fst(f5(DHKeyR, Na, ~Nb, MacAddI, ~MacAdd)), Na, ~Nb, '0',
                             'DisplayYesNo', MacAddI, ~MacAdd)
                     ) @ #vk.11 )
                case c_f6
                solve( !KU( ~Nb ) @ #vk.42 )
                  case NC_ResDSendNonceDisplay
                  solve( !KU( fst(f5(DHKeyR, Na, ~Nb, MacAddI, ~MacAdd)) ) @ #vk.42 )
                    case c_fst
                    solve( !KU( f5(DHKeyR, Na, ~Nb, MacAddI, ~MacAdd) ) @ #vk.43 )
                      case c_f5
                      solve( splitEqs(0) )
                        case split_case_1
                        solve( splitEqs(1) )
                          case split_case_2
                          solve( !KU( DHpkI^~skR ) @ #vk.44 )
                            case ResDRecDHSendDH
                            solve( splitEqs(2) )
                              case split_case_2
                              SOLVED // trace found
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma MITMP [heuristic={tacticMITM}]:
  all-traces
  "∀ I R #i.
    (MP( I, R ) @ #i) ⇒
    (¬(∃ LTKI LTKR #t1 #t2.
        (((¬(∀ #i.1.
              (Commit_Init( I, R, <'LTK', LTKI> ) @ #i.1) ⇒
              ((∃ #j. Running_Res( R, I, <'LTK', LTKI> ) @ #j) ∨
               (∃ #k. InitDJW( ) @ #k)))) ∧
          (¬(∀ #i.1.
              (Commit_Res( R, I, <'LTK', LTKR> ) @ #i.1) ⇒
              ((∃ #j. Running_Init( I, R, <'LTK', LTKR> ) @ #j) ∨
               (∃ #k. ResDJW( ) @ #k))))) ∧
         (K( LTKI ) @ #t1)) ∧
        (K( LTKR ) @ #t2)))"
/*
guarded formula characterizing all counter-examples:
"∃ I R #i.
  (MP( I, R ) @ #i)
 ∧
  ∃ LTKI LTKR #t1 #t2.
   (K( LTKI ) @ #t1) ∧ (K( LTKR ) @ #t2)
  ∧
   (∃ #i.1.
     (Commit_Init( I, R, <'LTK', LTKI> ) @ #i.1)
    ∧
     (∀ #j. (Running_Res( R, I, <'LTK', LTKI> ) @ #j) ⇒ ⊥) ∧
     (∀ #k. (InitDJW( ) @ #k) ⇒ ⊥)) ∧
   (∃ #i.1.
     (Commit_Res( R, I, <'LTK', LTKR> ) @ #i.1)
    ∧
     (∀ #j. (Running_Init( I, R, <'LTK', LTKR> ) @ #j) ⇒ ⊥) ∧
     (∀ #k. (ResDJW( ) @ #k) ⇒ ⊥))"
*/
simplify
solve( InitDSentEa( InitD, I, IOCapabilityI, OOBflagI, MITMI, R,
                    IOCapabilityR, OOBflagR, MITMR, ~skI, DHpkR, DHKeyI, ra, rb, ~Na, Nb,
                    MacKeyI, LTKI
       ) ▶₀ #i )
  case InitDSendEa_case_04
  solve( In_A( <'DisplayConfirm', 'Device', 'User'>, $D, $User, m
         ) ▶₂ #vr.11 )
    case receive_authenticated
    solve( In_A( <'AskforInput', 'Device', 'User'>, ResD, $User, 'Input'
           ) ▶₃ #vr.11 )
      case receive_authenticated
      solve( Commit_Init( ~MacAdd, R, <'LTK', LTKI.1> ) @ #i.1 )
        case InitDCheck
        solve( InitDSentEa( InitD, ~MacAdd, IOCapabilityI, OOBflagI, MITMI, R,
                            IOCapabilityR, OOBflagR, MITMR.1, ~skI.1, DHpkR.1, DHKeyI.1, ra, rb,
                            ~Na.1, Nb.1, MacKeyI, LTKI.1
               ) ▶₀ #i.1 )
          case InitDSendEa
          solve( Commit_Res( R, ~MacAdd, <'LTK', LTKR> ) @ #i.1 )
            case ResDSendEb
            solve( !InitDKeySize( KeySizeInit ) ▶₀ #i.1 )
              case ResDSResponse
              solve( State_Res_OK( ResD, ~MacAdd, IOCapabilityI, OOBflagI, MITMI, R,
                                   IOCapabilityR, OOBflagR, MITMR.1, ~skR, DHpkI, DHKeyR, ra, rb, Na.1,
                                   ~Nb.1
                     ) ▶₁ #i.1 )
                case PE_ResDCheckSendNonceOK
                solve( !KU( ~MacAdd.1 ) @ #vk.1 )
                  case Advertising
                  solve( !KU( ~MacAdd ) @ #vk.17 )
                    case InitDRequest
                    solve( !KU( f6(fst(f5(DHKeyI, ~Na, Nb, ~MacAdd, ~MacAdd.1)), Nb, ~Na,
                                   '0', 'DisplayYesNo', ~MacAdd.1, ~MacAdd)
                           ) @ #vk.21 )
                      case c_f6
                      solve( !KU( ~Na ) @ #vk.52 )
                        case NC_InitDSendNonce_KeyboardDisplay_DisplayYesNo
                        solve( !KU( f6(fst(f5(DHKeyR, Na.1, ~Nb.1, ~MacAdd, ~MacAdd.1)), Na.1,
                                       ~Nb.1, g2('g'^~skI, DHpkR, ~Na, Nb), 'DisplayOnly', ~MacAdd, ~MacAdd.1)
                               ) @ #vk.49 )
                          case c_f6
                          solve( !KU( ~Nb.1 ) @ #vk.54 )
                            case PE_ResDCheckSendNonceOK
                            solve( !KU( f4(DHpkR, 'g'^~skI, Nb, '0') ) @ #vk.42 )
                              case c_f4
                              solve( !KU( 'g'^~skI ) @ #vk.56 )
                                case InitDSendDH
                                solve( !KU( f4(DHpkI, 'g'^~skR, Na.1, g2('g'^~skI, DHpkR, ~Na, Nb))
                                       ) @ #vk.53 )
                                  case c_f4
                                  solve( !KU( 'g'^~skR ) @ #vk.57 )
                                    case ResDRecDHSendDH
                                    solve( !KU( fst(f5(DHKeyI, ~Na, Nb, ~MacAdd, ~MacAdd.1)) ) @ #vk.55 )
                                      case c_fst
                                      solve( !KU( f5(DHKeyI, ~Na, Nb, ~MacAdd, ~MacAdd.1) ) @ #vk.58 )
                                        case c_f5
                                        solve( !KU( fst(f5(DHKeyR, Na.1, ~Nb.1, ~MacAdd, ~MacAdd.1))
                                               ) @ #vk.57 )
                                          case c_fst
                                          solve( !KU( f5(DHKeyR, Na.1, ~Nb.1, ~MacAdd, ~MacAdd.1) ) @ #vk.60 )
                                            case c_f5
                                            solve( !KU( g2('g'^~skI, DHpkR, ~Na, Nb) ) @ #vk.59 )
                                              case c_g2
                                              solve( splitEqs(2) )
                                                case split_case_1
                                                solve( !KU( resize(snd(f5(DHKeyI, ~Na, Nb, ~MacAdd,
                                                                          ~MacAdd.1)),
                                                                   KeySizeRes)
                                                       ) @ #vk.34 )
                                                  case c_resize
                                                  solve( !KU( snd(f5(DHKeyI, ~Na, Nb, ~MacAdd, ~MacAdd.1))
                                                         ) @ #vk.62 )
                                                    case c_snd
                                                    solve( splitEqs(8) )
                                                      case split_case_1
                                                      solve( !KU( resize(snd(f5(DHKeyR, Na.1, ~Nb.1, ~MacAdd,
                                                                                ~MacAdd.1)),
                                                                         KeySizeInit)
                                                             ) @ #vk.36 )
                                                        case c_resize
                                                        solve( !KU( snd(f5(DHKeyR, Na.1, ~Nb.1, ~MacAdd,
                                                                           ~MacAdd.1))
                                                               ) @ #vk.63 )
                                                          case c_snd
                                                          solve( splitEqs(1) )
                                                            case split_case_2
                                                            solve( !KU( DHpkR^~skI ) @ #vk.62 )
                                                              case InitDSendDH
                                                              solve( splitEqs(4) )
                                                                case split_case_2
                                                                solve( !KU( DHpkI^~skR ) @ #vk.62 )
                                                                  case ResDRecDHSendDH
                                                                  SOLVED // trace found
                                                                qed
                                                              qed
                                                            qed
                                                          qed
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma LTKCP [heuristic={tacticSecrecy}]:
  all-traces
  "∀ I R LTKI LTKR #i #j.
    ((LTK( I, R, LTKI ) @ #i) ∧ (LTK( R, I, LTKR ) @ #j)) ⇒
    (¬(((¬(∀ #i.1.
            (Commit_Init( I, R, <'LTK', LTKI> ) @ #i.1) ⇒
            ((∃ #j.1. Running_Res( R, I, <'LTK', LTKI> ) @ #j.1) ∨
             (∃ #k. InitDJW( ) @ #k)))) ∧
        (¬(∀ #i.1.
            (Commit_Res( R, I, <'LTK', LTKR> ) @ #i.1) ⇒
            ((∃ #j.1. Running_Init( I, R, <'LTK', LTKR> ) @ #j.1) ∨
             (∃ #k. ResDJW( ) @ #k))))) ∧
       (¬(∃ #t1 #t2. (K( LTKI ) @ #t1) ∧ (K( LTKR ) @ #t2)))))"
/*
guarded formula characterizing all counter-examples:
"∃ I R LTKI LTKR #i #j.
  (LTK( I, R, LTKI ) @ #i) ∧ (LTK( R, I, LTKR ) @ #j)
 ∧
  (∃ #i.1.
    (Commit_Init( I, R, <'LTK', LTKI> ) @ #i.1)
   ∧
    (∀ #j.1. (Running_Res( R, I, <'LTK', LTKI> ) @ #j.1) ⇒ ⊥) ∧
    (∀ #k. (InitDJW( ) @ #k) ⇒ ⊥)) ∧
  (∃ #i.1.
    (Commit_Res( R, I, <'LTK', LTKR> ) @ #i.1)
   ∧
    (∀ #j.1. (Running_Init( I, R, <'LTK', LTKR> ) @ #j.1) ⇒ ⊥) ∧
    (∀ #k. (ResDJW( ) @ #k) ⇒ ⊥)) ∧
  (∀ #t1 #t2. (K( LTKI ) @ #t1) ∧ (K( LTKR ) @ #t2) ⇒ ⊥)"
*/
simplify
solve( Commit_Init( I, R, <'LTK', LTKI> ) @ #i.1 )
  case InitDCheck
  solve( InitDSentEa( InitD, I, IOCapabilityI, OOBflagI, MITMI, R,
                      IOCapabilityR, OOBflagR, MITMR, ~skI, DHpkR, DHKeyI, ra, rb, ~Na, Nb,
                      MacKeyI, LTKI
         ) ▶₀ #i )
    case InitDSendEa_case_04
    solve( In_A( <'DisplayConfirm', 'Device', 'User'>, $D, $User, m
           ) ▶₂ #vr.11 )
      case receive_authenticated
      solve( In_A( <'AskforInput', 'Device', 'User'>, ResD, $User, 'Input'
             ) ▶₃ #vr.11 )
        case receive_authenticated
        solve( Commit_Res( R, ~MacAdd, <'LTK', LTKR> ) @ #i.2 )
          case ResDSendEb
          solve( !InitDKeySize( KeySizeInit ) ▶₀ #i.1 )
            case ResDSResponse
            solve( State_Res_OK( ResD, ~MacAdd, IOCapabilityI, OOBflagI, MITMI, R,
                                 IOCapabilityR, OOBflagR, MITMR.1, ~skR, DHpkI, DHKeyR, ra, rb, Na.1,
                                 ~Nb.1
                   ) ▶₁ #i.1 )
              case PE_ResDCheckSendNonceOK
              solve( !KU( ~MacAdd.1 ) @ #vk.1 )
                case Advertising
                solve( !KU( ~MacAdd ) @ #vk.17 )
                  case InitDRequest
                  solve( !KU( f6(fst(f5(DHKeyI, ~Na, Nb, ~MacAdd, ~MacAdd.1)), Nb, ~Na,
                                 '0', 'DisplayYesNo', ~MacAdd.1, ~MacAdd)
                         ) @ #vk.21 )
                    case c_f6
                    solve( !KU( ~Na ) @ #vk.50 )
                      case NC_InitDSendNonce_KeyboardDisplay_DisplayYesNo
                      solve( !KU( f6(fst(f5(DHKeyR, Na.1, ~Nb.1, ~MacAdd, ~MacAdd.1)), Na.1,
                                     ~Nb.1, g2('g'^~skI, DHpkR, ~Na, Nb), 'DisplayOnly', ~MacAdd, ~MacAdd.1)
                             ) @ #vk.47 )
                        case c_f6
                        solve( !KU( ~Nb.1 ) @ #vk.52 )
                          case PE_ResDCheckSendNonceOK
                          solve( !KU( f4(DHpkR, 'g'^~skI, Nb, '0') ) @ #vk.40 )
                            case c_f4
                            solve( !KU( f4(DHpkI, 'g'^~skR, Na.1, g2('g'^~skI, DHpkR, ~Na, Nb))
                                   ) @ #vk.50 )
                              case c_f4
                              solve( !KU( 'g'^~skI ) @ #vk.54 )
                                case InitDSendDH
                                solve( !KU( 'g'^~skR ) @ #vk.55 )
                                  case ResDRecDHSendDH
                                  solve( LTK( ~MacAdd, ~MacAdd.1, LTKI ) @ #i.2 )
                                    case InitDCheck
                                    solve( InitDSentEa( InitD, ~MacAdd, IOCapabilityI, OOBflagI, MITMI.1,
                                                        ~MacAdd.1, IOCapabilityR, OOBflagR, MITMR.1, ~skI.1,
                                                        DHpkR.1, DHKeyI.1, ra, rb, ~Na.2, Nb.2, MacKeyI, LTKI
                                           ) ▶₀ #i.2 )
                                      case InitDSendEa
                                      solve( LTK( ~MacAdd.1, ~MacAdd, LTKR ) @ #j )
                                        case ResDSendEb
                                        solve( !InitDKeySize( KeySizeInit ) ▶₀ #j )
                                          case ResDSResponse
                                          solve( State_Res_OK( ResD, ~MacAdd, IOCapabilityI, OOBflagI, MITMI,
                                                               ~MacAdd.1, IOCapabilityR, OOBflagR, MITMR.1,
                                                               ~skR, DHpkI, DHKeyR, ra, rb, Na.1, ~Nb.1
                                                 ) ▶₁ #j )
                                            case PE_ResDCheckSendNonceOK
                                            solve( !KU( fst(f5(DHKeyI, ~Na, Nb, ~MacAdd, ~MacAdd.1))
                                                   ) @ #vk.53 )
                                              case c_fst
                                              solve( !KU( f5(DHKeyI, ~Na, Nb, ~MacAdd, ~MacAdd.1) ) @ #vk.56 )
                                                case c_f5
                                                solve( !KU( fst(f5(DHKeyR, Na.1, ~Nb.1, ~MacAdd, ~MacAdd.1))
                                                       ) @ #vk.55 )
                                                  case c_fst
                                                  solve( !KU( f5(DHKeyR, Na.1, ~Nb.1, ~MacAdd, ~MacAdd.1)
                                                         ) @ #vk.58 )
                                                    case c_f5
                                                    solve( !KU( g2('g'^~skI, DHpkR, ~Na, Nb) ) @ #vk.57 )
                                                      case c_g2
                                                      solve( splitEqs(2) )
                                                        case split_case_1
                                                        solve( splitEqs(5) )
                                                          case split_case_1
                                                          solve( splitEqs(1) )
                                                            case split_case_2
                                                            solve( !KU( DHpkR^~skI ) @ #vk.58 )
                                                              case InitDSendDH
                                                              solve( splitEqs(4) )
                                                                case split_case_2
                                                                solve( !KU( DHpkI^~skR ) @ #vk.58 )
                                                                  case ResDRecDHSendDH
                                                                  SOLVED // trace found
                                                                qed
                                                              qed
                                                            qed
                                                          qed
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma SecAuthLTK [heuristic={tacticSecrecy}]:
  all-traces
  "∀ I R LTK #i #j.
    ((FSecAuthLTK( I, R, LTK ) @ #i) ∧ (FSecAuthLTK( R, I, LTK ) @ #j)) ⇒
    (((∀ #i.1.
        (Commit_Init( I, R, <'LTK', LTK> ) @ #i.1) ⇒
        (∃ #j.1. Running_Res( R, I, <'LTK', LTK> ) @ #j.1)) ∧
      (∀ #i.1.
        (Commit_Res( R, I, <'LTK', LTK> ) @ #i.1) ⇒
        (∃ #j.1. Running_Init( I, R, <'LTK', LTK> ) @ #j.1))) ⇒
     (¬(∃ #k. K( LTK ) @ #k)))"
/*
guarded formula characterizing all counter-examples:
"∃ I R LTK #i #j.
  (FSecAuthLTK( I, R, LTK ) @ #i) ∧ (FSecAuthLTK( R, I, LTK ) @ #j)
 ∧
  (∀ #i.1.
    (Commit_Init( I, R, <'LTK', LTK> ) @ #i.1)
   ⇒
    ∃ #j.1. (Running_Res( R, I, <'LTK', LTK> ) @ #j.1)) ∧
  (∀ #i.1.
    (Commit_Res( R, I, <'LTK', LTK> ) @ #i.1)
   ⇒
    ∃ #j.1. (Running_Init( I, R, <'LTK', LTK> ) @ #j.1)) ∧
  (∃ #k. (K( LTK ) @ #k))"
*/
simplify
solve( FSecAuthLTK( I, R, LTK ) @ #i )
  case InitDCheck
  solve( InitDSentEa( InitD, I, IOCapabilityI, OOBflagI, MITMI, R,
                      IOCapabilityR, OOBflagR, MITMR, ~skI, DHpkR, DHKeyI, ra, rb, ~Na, Nb,
                      MacKeyI, LTK
         ) ▶₀ #i )
    case InitDSendEa_case_06
    solve( In_A( <'DisplayConfirm', 'Device', 'User'>, $D, $User, m
           ) ▶₂ #vr.11 )
      case receive_authenticated
      solve( In_A( <'DisplayConfirm', 'Device', 'User'>, ResD, $User,
                   g2('g'^~skI, DHpkR, ~Na, Nb)
             ) ▶₃ #vr.11 )
        case receive_authenticated_case_2
        solve( Running_Res( R, ~MacAdd, <'LTK', LTK> ) @ #j.1 )
          case ResDSendEb
          solve( !InitDKeySize( KeySizeInit ) ▶₀ #j )
            case ResDSResponse
            solve( Running_Init( ~MacAdd, R, <'LTK', LTK> ) @ #j.2 )
              case InitDSendEa
              solve( State_Init_OK( InitD, ~MacAdd, IOCapabilityI.1, OOBflagI.1,
                                    MITMI.1, R, IOCapabilityR.1, OOBflagR.1, MITMR.2, ~skI.1, DHpkR, DHKeyI,
                                    ra.1, rb.1, ~Na.2, Nb.2
                     ) ▶₁ #j.1 )
                case NC_InitDOk
                solve( State_Res_OK( ResD, ~MacAdd, IOCapabilityI, OOBflagI, MITMI, R,
                                     IOCapabilityR, OOBflagR, MITMR.1, ~skR.1, DHpkI, DHKeyR, ra, rb, Na.1,
                                     ~Nb.1
                       ) ▶₁ #j )
                  case NC_ResDOK
                  solve( FSecAuthLTK( ~MacAdd.1, ~MacAdd, LTK ) @ #j.1 )
                    case ResDSendEb
                    solve( !InitDKeySize( KeySizeInit.1 ) ▶₀ #j.1 )
                      case ResDSResponse
                      solve( State_Res_OK( ResD, ~MacAdd, IOCapabilityI, OOBflagI, MITMI.1,
                                           ~MacAdd.1, IOCapabilityR, OOBflagR, MITMR.1, ~skR.1, DHpkI, DHKeyR,
                                           ra, rb, Na.1, ~Nb.1
                             ) ▶₁ #j.1 )
                        case NC_ResDOK
                        solve( !KU( ~MacAdd.1 ) @ #vk.2 )
                          case Advertising
                          solve( !KU( ~MacAdd ) @ #vk.16 )
                            case InitDRequest
                            solve( !KU( ~Na ) @ #vk.38 )
                              case NC_InitDSendNonce_KeyboardDisplay_KeyboardDisplay
                              solve( !KU( ~Nb ) @ #vk.35 )
                                case NC_ResDSendNonceDisplay
                                solve( !KU( f6(fst(f5('g'^(~skI*~skR), ~Na, ~Nb, ~MacAdd, ~MacAdd.1)),
                                               ~Nb, ~Na, '0', 'KeyboardDisplay', ~MacAdd.1, ~MacAdd)
                                       ) @ #vk.22 )
                                  case ResDSendEb
                                  solve( !KU( f6(fst(f5('g'^(~skI*~skR), ~Na, ~Nb, ~MacAdd, ~MacAdd.1)),
                                                 ~Na, ~Nb, '0', 'KeyboardDisplay', ~MacAdd, ~MacAdd.1)
                                         ) @ #vk.45 )
                                    case InitDSendEa
                                    solve( !KU( f4('g'^~skR, 'g'^~skI, ~Nb, '0') ) @ #vk.38 )
                                      case NC_ResDCommitment_KeyboardDisplay_KeyboardDisplay
                                      solve( !KU( 'g'^~skI ) @ #vk.40 )
                                        case InitDSendDH
                                        solve( !KU( 'g'^~skR ) @ #vk.40 )
                                          case ResDRecDHSendDH
                                          solve( splitEqs(2) )
                                            case split_case_2
                                            solve( !KU( left(snd(f5('g'^(~skI*~skR), ~Na, ~Nb, ~MacAdd,
                                                                    ~MacAdd.1)))
                                                   ) @ #vk.26 )
                                              case crack_low_entropy_message_case_3
                                              solve( !MDerive1( left(snd(f5('g'^(~skI*~skR), ~Na, ~Nb,
                                                                            ~MacAdd, ~MacAdd.1))),
                                                                m2
                                                     ) ▶₀ #vr.44 )
                                                case orcale_message_valve_case_1
                                                solve( !MDerive0( combine(left(snd(f5('g'^(~skI*~skR), ~Na,
                                                                                      ~Nb, ~MacAdd,
                                                                                      ~MacAdd.1))),
                                                                          m2.1),
                                                                  m2
                                                       ) ▶₀ #vr.46 )
                                                  case orcale_message_derive2
                                                  solve( !MDerive0( combine(m1,
                                                                            combine(left(snd(f5('g'^(~skI*~skR
                                                                                                    ),
                                                                                                ~Na, ~Nb,
                                                                                                ~MacAdd,
                                                                                                ~MacAdd.1))),
                                                                                    m2)),
                                                                    m2.1
                                                         ) ▶₀ #vr.47 )
                                                    case ResEncRequest
                                                    solve( !MDerive1( senc(<~SKDI, ~SKDR>,
                                                                           <<~IVI, ~IVR>, 
                                                                            left(snd(f5('g'^(~skI*~skR), ~Na,
                                                                                        ~Nb, ~MacAdd,
                                                                                        ~MacAdd.1)))
                                                                           >),
                                                                      fm
                                                           ) ▶₁ #vr.44 )
                                                      case orcale_message_valve_case_1
                                                      solve( !KU( senc('START_ENC',
                                                                       senc(<~SKDI, ~SKDR>,
                                                                            <<~IVI, ~IVR>, 
                                                                             left(snd(f5('g'^(~skI*~skR), ~Na,
                                                                                         ~Nb, ~MacAdd,
                                                                                         ~MacAdd.1)))
                                                                            >))
                                                             ) @ #vk.45 )
                                                        case InitStartEnc1
                                                        solve( !KU( ~IVI ) @ #vk.52 )
                                                          case InitEncRequset
                                                          solve( !KU( ~IVR ) @ #vk.54 )
