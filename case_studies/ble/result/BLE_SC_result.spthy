lemma SecrecySK [heuristic={tacticSecrecy}]:
  all-traces
  "∀ LTK SK I R #i #j.
    ((FSecAuthSK( 'SK_I', I, R, LTK, SK ) @ #i) ∧
     (FSecAuthSK( 'SK_R', R, I, LTK, SK ) @ #j)) ⇒
    (((∀ #i.1.
        (Commit_Init( I, R, <'LTK', LTK> ) @ #i.1) ⇒
        (∃ #j.1. Running_Res( R, I, <'LTK', LTK> ) @ #j.1)) ∧
      (∀ #i.1.
        (Commit_Res( R, I, <'LTK', LTK> ) @ #i.1) ⇒
        (∃ #j.1. Running_Init( I, R, <'LTK', LTK> ) @ #j.1))) ⇒
     (¬(∃ #k. K( SK ) @ #k)))"
/*
guarded formula characterizing all counter-examples:
"∃ LTK SK I R #i #j.
  (FSecAuthSK( 'SK_I', I, R, LTK, SK ) @ #i) ∧
  (FSecAuthSK( 'SK_R', R, I, LTK, SK ) @ #j)
 ∧
  (∀ #i.1.
    (Commit_Init( I, R, <'LTK', LTK> ) @ #i.1)
   ⇒
    ∃ #j.1. (Running_Res( R, I, <'LTK', LTK> ) @ #j.1)) ∧
  (∀ #i.1.
    (Commit_Res( R, I, <'LTK', LTK> ) @ #i.1)
   ⇒
    ∃ #j.1. (Running_Init( I, R, <'LTK', LTK> ) @ #j.1)) ∧
  (∃ #k. (K( SK ) @ #k))"
*/
simplify
