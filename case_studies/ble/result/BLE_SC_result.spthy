     !EntropyLow( right(snd(f5(DHKeyR, Na, ~Nb, MacAddI, MacAddR))) )
     ]
    variants (modulo AC)
    1. ~Nb   = ~Nb.41
       DHKeyR
             = DHKeyR.43
       KeySizeInit
             = KeySizeInit.48
       MacAddI
             = MacAddI.51
       MacAddR
             = MacAddR.52
       Na    = Na.53
       z     = resize(snd(f5(DHKeyR.43, Na.53, ~Nb.41, MacAddI.51, MacAddR.52)),
                      KeySizeInit.48)
    
    2. ~Nb   = ~Nb.41
       DHKeyR
             = DHKeyR.43
       KeySizeInit
             = N1
       MacAddI
             = MacAddI.51
       MacAddR
             = MacAddR.52
       Na    = Na.53
       z     = left(snd(f5(DHKeyR.43, Na.53, ~Nb.41, MacAddI.51, MacAddR.52)))
    
    3. ~Nb   = ~Nb.41
       DHKeyR
             = DHKeyR.43
       KeySizeInit
             = N2
       MacAddI
             = MacAddI.51
       MacAddR
             = MacAddR.52
       Na    = Na.53
       z     = combine(left(snd(f5(DHKeyR.43, Na.53, ~Nb.41, MacAddI.51,
                                   MacAddR.52))),
                       right(snd(f5(DHKeyR.43, Na.53, ~Nb.41, MacAddI.51, MacAddR.52))))
  */

rule (modulo E) InitDCheck[color=#bbffff]:
   [
   InitDSentEa( InitD, MacAddI, IOCapabilityI, OOBflagI, MITMI, MacAddR,
                IOCapabilityR, OOBflagR, MITMR, ~skI, DHpkR, DHKeyI, ra, rb, ~Na, Nb,
                MacKeyI, LTKI
   ),
   In( <MacAddR, MacAddI, Eb> )
   ]
  --[
  Eq( Eb, f6(MacKeyI, Nb, ~Na, ra, IOCapabilityR, MacAddR, MacAddI) ),
  Commit_Init( MacAddI, MacAddR, <'LTK', LTKI> ),
  Commit_Init( MacAddI, MacAddR, <'DHKey', DHKeyI> ), FinishedInit( ),
  MP( MacAddI, MacAddR ), LTK( MacAddI, MacAddR, LTKI ),
  FSecAuthLTK( MacAddI, MacAddR, LTKI )
  ]->
   [
   !State_InitDAuthSta2_End( InitD, MacAddI, IOCapabilityI, OOBflagI, MITMI,
                             MacAddR, IOCapabilityR, OOBflagR, MITMR, ~skI, DHpkR, DHKeyI, ra, rb,
                             ~Na, Nb, MacKeyI, LTKI
   )
   ]

  /* has exactly the trivial AC variant */

