theory BLE_SC_JW_NC_PE_OOB begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: N1/0, N2/0, combine/2, decombine/1, f4/4, f5/5, f6/7, fst/1,
           g2/4, left/1, pair/2, resize/2, right/1, sdec/2, senc/2, snd/1
equations:
    decombine(combine(m1, m2)) = <m1, m2>,
    fst(<x.1, x.2>) = x.1,
    resize(m, N1) = left(m),
    resize(m, N2) = combine(left(m), right(m)),
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

tactic: tacticSecrecy
presort: S
prio: {id}
  regex".*KU\(\s~skI.*"
prio: {id}
  regex".*KU\(\s~skR.*"
prio: {id}
  regex".*InitDSentEa.*"
prio: {id}
  regex".*In_A.*"
prio: {id}
  regex".*Init.*"
prio: {id}
  regex".*Res.*"
prio: {id}
  regex".*FSecAuthSK.*"
prio: {id}
  regex".*FSecAuthLTK.*"
prio: {id}
  regex".*KU\(\s~MacAdd.*"
prio: {id}
  regex".*KU\(\s~Na.*"
prio: {id}
  regex".*KU\(\s~Nb.*"
prio: {id}
  regex".*KU\(\sf6.*"
prio: {id}
  regex".*KU\(\sf5.*"
prio: {id}
  regex".*KU\(\sf4.*"
prio: {id}
  regex".*KU\(\s'g'.*\^\(~skI\*~skR\).*"
prio: {id}
  regex".*KU\(\s'g'\^~skI.*"
prio: {id}
  regex".*KU\(\s'g'\^~skR.*"
prio: {id}
  regex".*KU\(\ssenc\('.*'.*"
prio: {id}
  regex".*KU\(\ssenc\(.*"
deprio: {id}
  regex".*splitEqs.*"
deprio: {id}
  regex".*KU\(\scombine.*"
deprio: {id}
  regex".*EntropyLow.*"
deprio: {id}
  regex".*MDerive0\((?!\s*m\d+(\.\d+)?,\s*((m\d+(\.\d+)?)|(fm(\.\d+)?))).*"
deprio: {id}
  regex".*MDerive0\(\sm\d(\.\d+)?,\s((m\d(\.\d+)?)|(fm(\.\d+)?))"
deprio: {id}
  regex".*MDerive1\((?!\s*m\d+(\.\d+)?,\s*((m\d+(\.\d+)?)|(fm(\.\d+)?))).*"
deprio: {id}
  regex".*MDerive1\(\sm\d(\.\d+)?,\s((m\d(\.\d+)?)|(fm(\.\d+)?))"
deprio: {id}
  regex".*KU\(\s~IV.*"
deprio: {id}
  regex".*KU\(\s~SKD.*"


tactic: tacticMITM
presort: S
prio: {id}
  regex".*KU\(\s~skI.*"
prio: {id}
  regex".*KU\(\s~skR.*"
prio: {id}
  regex".*InitDSentEa.*"
prio: {id}
  regex".*KU\(\s'g'.*\^\(~skI\*~skR\).*"
prio: {id}
