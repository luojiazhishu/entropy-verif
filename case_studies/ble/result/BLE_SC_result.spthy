rule (modulo E) ResEncRequest[color=#fff68f]:
   [
   In( <'ENC_REQ', ~IVI, ~SKDI> ),
   !State_ResDAuthSta2_End( ResD, MacAddI, IOCapabilityI, OOBflagI, MITMI,
                            MacAddR, IOCapabilityR, OOBflagR, MITMR, ~skR, DHpkI, DHKeyR, ra, rb, Na,
                            ~Nb, LTKR
   ),
   Fr( ~IVR ), Fr( ~SKDR )
   ]
  -->
   [
   Out( <'ENC_REQ', ~IVR, ~SKDR> ), Out( 'START_ENC_R' ),
   State_ResEncRequest_End( ResD, MacAddI, IOCapabilityI, OOBflagI, MITMI,
                            MacAddR, IOCapabilityR, OOBflagR, MITMR, ~skR, DHpkI, DHKeyR, ra, rb, Na,
                            ~Nb, LTKR, senc(<~SKDI, ~SKDR>, <<~IVI, ~IVR>, LTKR>)
   ),
   !MDerive0( combine(<~SKDI, ~SKDR>, combine(LTKR, <~IVI, ~IVR>)),
              senc(<~SKDI, ~SKDR>, <<~IVI, ~IVR>, LTKR>)
   ),
   !MDerive0( combine(~SKDI, ~SKDR), <~SKDI, ~SKDR> ),
   !MDerive0( combine(~IVI, ~IVR), <~IVI, ~IVR> )
   ]

