                    IOCapabilityR, OOBflagR, MITMR, ~skI, DHpkR, DHKeyI, ra, rb, ~Na, Nb
     )
     ]
    --[ Running_Init( MacAddI, MacAddR, <'LTK', z> ), SecLTK( z ) ]->
     [
     Out( <MacAddI, MacAddR, 
           f6(fst(f5(DHKeyI, ~Na, Nb, MacAddI, MacAddR)), ~Na, Nb, rb,
              IOCapabilityI, MacAddI, MacAddR)
          >
     ),
     InitDSentEa( InitD, MacAddI, IOCapabilityI, OOBflagI, MITMI, MacAddR,
                  IOCapabilityR, OOBflagR, MITMR, ~skI, DHpkR, DHKeyI, ra, rb, ~Na, Nb,
                  fst(f5(DHKeyI, ~Na, Nb, MacAddI, MacAddR)), z
     ),
     !MDerive0( combine(Nb,
                        combine(rb,
                                combine(fst(f5(DHKeyI, ~Na, Nb, MacAddI, MacAddR)),
                                        combine(MacAddR, combine(IOCapabilityI, combine(~Na, MacAddI)))))),
                f6(fst(f5(DHKeyI, ~Na, Nb, MacAddI, MacAddR)), ~Na, Nb, rb,
                   IOCapabilityI, MacAddI, MacAddR)
     ),
     !MDerive0( combine(Nb,
                        combine(DHKeyI, combine(MacAddR, combine(~Na, MacAddI)))),
                fst(f5(DHKeyI, ~Na, Nb, MacAddI, MacAddR))
     ),
     !MDerive0( combine(Nb,
                        combine(DHKeyI, combine(MacAddR, combine(~Na, MacAddI)))),
                fst(f5(DHKeyI, ~Na, Nb, MacAddI, MacAddR))
     ),
     !MDerive0( combine(Nb,
                        combine(DHKeyI,
                                combine(MacAddR, combine(KeySizeRes, combine(~Na, MacAddI))))),
                z
     ),
     !EntropyLow( left(snd(f5(DHKeyI, ~Na, Nb, MacAddI, MacAddR))) ),
     !EntropyLow( right(snd(f5(DHKeyI, ~Na, Nb, MacAddI, MacAddR))) )
     ]
    variants (modulo AC)
    1. ~Na   = ~Na.40
       DHKeyI
             = DHKeyI.42
       KeySizeRes
             = KeySizeRes.47
       MacAddI
             = MacAddI.50
       MacAddR
             = MacAddR.51
       Nb    = Nb.52
       z     = resize(snd(f5(DHKeyI.42, ~Na.40, Nb.52, MacAddI.50, MacAddR.51)),
                      KeySizeRes.47)
    
    2. ~Na   = ~Na.40
       DHKeyI
             = DHKeyI.42
       KeySizeRes
             = N1
       MacAddI
             = MacAddI.50
       MacAddR
             = MacAddR.51
       Nb    = Nb.52
       z     = left(snd(f5(DHKeyI.42, ~Na.40, Nb.52, MacAddI.50, MacAddR.51)))
    
    3. ~Na   = ~Na.40
       DHKeyI
             = DHKeyI.42
       KeySizeRes
             = N2
       MacAddI
             = MacAddI.50
       MacAddR
             = MacAddR.51
       Nb    = Nb.52
       z     = combine(left(snd(f5(DHKeyI.42, ~Na.40, Nb.52, MacAddI.50,
                                   MacAddR.51))),
                       right(snd(f5(DHKeyI.42, ~Na.40, Nb.52, MacAddI.50, MacAddR.51))))
