   In_A( <'Display', 'Device', 'User'>, D1, User, m ),
   In_A( <'AskforInput', 'Device', 'User'>, D2, User, 'Input' )
   ]
  --[ AFOneInteraction( ) ]->
   [ Out_A( <'Input', 'User', 'Device'>, User, D2, m ) ]

  // loop breakers: [2,3]
